{
  "manifest_version": 3,
  "name": "המודל של אוגוסט",
  "version": "0.2.0",
  "description": "שכבת תצוגת מורה מעל מרחב Moodle הקיים — ללא שינוי נתונים בגרסת V1.",
  "content_scripts": [
    {
      "matches": ["https://moodlemoe.lms.education.gov.il/*"],
      "js": [
        "src/detector.js",
        "src/adapter-registry.js",
        "src/adapters/moodle-course.js",
        "src/shell.js",
        "src/bootstrap.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
